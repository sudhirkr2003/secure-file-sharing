# Render backend production environment variables.
# Set these in Render Environment, never commit real values.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
STORAGE_TYPE=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY=YOUR_R2_ACCESS_KEY
R2_SECRET_KEY=YOUR_R2_SECRET_KEY
R2_BUCKET=YOUR_R2_BUCKET
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_GMAIL_ADDRESS
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
FRONTEND_URL=https://your-frontend.onrender.com
CLEANUP_FIXED_DELAY_MS=3600000
