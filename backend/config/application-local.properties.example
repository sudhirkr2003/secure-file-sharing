# LOCAL / PRIVATE CONFIGURATION
# DO NOT COMMIT THIS FILE TO GIT.
# Fill these values on your machine.

DB_URL=jdbc:mysql://localhost:3306/secure_file_sharing?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=YOUR_DATABASE_PASSWORD

JWT_SECRET=PUT_A_LONG_RANDOM_SECRET_HERE

# OTP email testing
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_GMAIL_ADDRESS
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Keep local file storage for now.
STORAGE_TYPE=local

FRONTEND_URL=http://localhost:5173

# R2 - fill these only when you switch STORAGE_TYPE to r2
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

CLEANUP_FIXED_DELAY_MS=3600000
